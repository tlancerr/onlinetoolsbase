"use client";

import Link from "next/link";
import toolsData from "./toolsData";
import { useMemo, useState, useEffect, useRef } from "react";

import { useTheme } from "./useTheme";

export default function SiteHeader() {
  const { theme, toggleTheme } = useTheme();
  const [query, setQuery] = useState("");
const searchRef = useRef<HTMLDivElement>(null);

// Close dropdown when clicking outside
useEffect(() => {
  function handleClickOutside(e: MouseEvent) {
    if (searchRef.current && !searchRef.current.contains(e.target as Node)) {
      setQuery(""); // closes dropdown instantly
    }
  }
  document.addEventListener("mousedown", handleClickOutside);
  return () => document.removeEventListener("mousedown", handleClickOutside);
}, []);

  const approvedCategories = [
    "Time and Age Tools",
    "Finance Tools",
    "Text Tools",
    "Image Tools",
    "Social Media Tools",
    "PDF Tools",

  ];

  const allCategories = Array.from(
    new Set(
      toolsData
        .map((t) => t.category.trim())
        .filter((c) => approvedCategories.includes(c))
    )
  );

  const filtered = useMemo(() => {
    if (!query.trim()) return [];
    const q = query.toLowerCase();
    return toolsData
      .filter(
        (t) =>
          t.title.toLowerCase().includes(q) ||
          t.category.toLowerCase().includes(q)
      )
      .slice(0, 8);
  }, [query]);

  function handleKeyDown(e: any) {
    if (e.key === "Enter" && filtered.length > 0) {
      window.location.href = `/tools/${filtered[0].slug}`;
    }
  }

  return (
    <header className="border-b border-slate-800 bg-slate-950/80 backdrop-blur">
      <div className="main-container flex items-center justify-between py-3 gap-4">
        {/* Logo */}
        <div className="flex items-center gap-2">
          <Link href="/" className="flex items-center gap-2">
            <div className="h-8 w-8 rounded-lg bg-blue-500 flex items-center justify-center text-sm font-bold text-white">
              OT
            </div>
            <div className="flex flex-col leading-tight">
              <span className="on-dark-text font-semibold text-slate-50">
                OnlineToolsBase
              </span>
              <span className="text-[11px] text-slate-400">
                Free online tools & calculators
              </span>
            </div>
          </Link>
        </div>

        {/* Search + categories (desktop) */}
        <div
  ref={searchRef}
  className="relative hidden md:block min-w-[260px] max-w-sm"
>

          <input
  className="tool-input text-xs pr-7"
  placeholder="Search tools (PDF, images, Instagram, loan...)"
  value={query}
  onChange={(e) => setQuery(e.target.value)}
  onKeyDown={handleKeyDown}
/>

{/* Clear (X) button */}
{query && (
  <button
    type="button"
    onClick={() => setQuery("")}
    className="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-400 text-xs"
  >
    ✖
  </button>
)}

          {filtered.length > 0 && (
            <div className="absolute mt-1 w-full rounded-md border border-slate-700 bg-slate-900 max-h-64 overflow-auto z-20">
              {filtered.map((tool) => (
                <Link
                  key={tool.slug}
                  href={`/tools/${tool.slug}`}
                  className="search-item block px-3 py-2 text-xs"

                  onClick={() => setQuery("")}
                >
                  <div className="font-medium text-slate-100">
                    {tool.title}
                  </div>
                  <div className="text-[10px] text-slate-500">
                    {tool.category}
                  </div>
                </Link>
              ))}
            </div>
          )}

          {/* Category chips under search */}
          <div className="mt-1 flex flex-wrap gap-1 text-[10px] text-slate-400">
            {allCategories.map((cat) => (
              <span
  key={cat}
  className="category-chip rounded-full border border-slate-700 px-2 py-0.5"
>

                {cat}
              </span>
            ))}
          </div>
        </div>

        {/* Right side: theme toggle */}
        <div className="flex items-center gap-2">
          <button
            type="button"
            onClick={toggleTheme}
            className="btn-secondary text-[11px] px-2 py-1"
          >
            {theme === "dark" ? "🌙 Dark" : "☀️ Light"}
          </button>
        </div>
      </div>
    </header>
  );
}
