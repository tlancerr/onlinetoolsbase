generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ToolUsage {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  toolSlug  String
  count     Int      @default(1)
  usageDate String
  createdAt DateTime @default(now())

  @@index([userId, toolSlug, usageDate])
  @@index([guestId, toolSlug, usageDate])
}
model SavedOutput {
  id        String   @id @default(cuid())
  userId    String
  toolSlug  String
  input     String
  output    String
  createdAt DateTime @default(now())

  @@index([userId, toolSlug])
  @@index([userId, createdAt])
}
